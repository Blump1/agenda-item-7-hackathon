# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---- Regulations.gov ----
# The key you already requested. Standard keys are rate limited (~1000 req/hour),
# so the poller checkpoints instead of re-scanning.
REGULATIONS_GOV_API_KEY=paste-your-key-here

# ---- Google Cloud ----
GOOGLE_CLOUD_PROJECT=agenda-item-7
GOOGLE_GENAI_USE_VERTEXAI=true

# Where Gemini is SERVED from. Must be "global" for Gemini 3.x -- regional
# endpoints such as us-central1 return 404 NOT_FOUND for these models, even
# though client.models.list() reports them as present in the region.
GOOGLE_CLOUD_LOCATION=global

# Where INFRASTRUCTURE lives (Cloud Run, Firestore, bucket). Regional.
GCP_REGION=us-central1

# ---- Models ----
# Verify with `python scripts/list_models.py` before trusting these.
#
# The contest requires Gemini 3.5 or newer. Verified against Vertex AI in
# us-central1: the flash line reaches 3.7, but the pro line stops at
# gemini-3.1-pro-preview, which is OLDER than 3.5 and therefore ineligible.
# So both tiers are flash: lite for the cheap relevance gate, full flash for
# the deep read.
TRIAGE_MODEL=gemini-3.5-flash-lite
ANALYST_MODEL=gemini-3.7-flash

# ---- Storage ----
FIRESTORE_DATABASE=(default)
GCS_BUCKET=

# ---- Behavior ----
# How far back the very first poll reaches, in days.
INITIAL_LOOKBACK_DAYS=7
# Max documents pulled per watch per run — a cost guardrail.
MAX_DOCS_PER_RUN=40
LOG_LEVEL=INFO
